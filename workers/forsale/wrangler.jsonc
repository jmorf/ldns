{
	// Private Worker: no `routes` and no `workers_dev` URL, so it is NOT
	// publicly reachable. The only caller is the ldns.com site Worker via the
	// FORSALE service binding declared in ldns2/wrangler.jsonc.
	//
	// Secret (set once, never committed):
	//   npx wrangler secret put DYNADOT_API_KEY
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "ldns-forsale",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-30",
	"workers_dev": false,
	"vars": {
		// Max paid Dynadot calls per UTC day. Tune to your plan; the counter
		// is global and fails closed, so exceeding it degrades to the free
		// signals (Afternic + parking fingerprint) rather than erroring.
		"DYNADOT_DAILY_LIMIT": "500"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "DYNADOT_BUDGET",
				"class_name": "DynadotBudget"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["DynadotBudget"]
		}
	],
	"observability": {
		"enabled": true
	}
}
