{
	"$schema": "node_modules/wrangler/config-schema.json",
	"account_id": "0a23f5213b008c927c4b9a8b9442b573",
	"name": "ldns2",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-04-30",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"services": [
		{
			// Private Worker holding the Dynadot key + daily spend ceiling.
			// Deploy workers/forsale first, or remove this binding — the
			// /api/forsale route degrades gracefully when it's absent.
			"binding": "FORSALE",
			"service": "ldns-forsale"
		}
	],
	"observability": {
		"enabled": true
	}
	// "placement": { "mode": "smart" },
	// "vars": { "MY_VARIABLE": "production_value" },
}
